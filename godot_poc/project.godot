; Godot 4 项目文件
; 主场景 = 班次界面（ui/main_ui.gd 里用代码搭 UI，方便 POC 阶段改布局）
; 想跑「无头一致性比对」而不是界面时，用 --script main.gd，详见 README。

[application]

config/name="人体值班室"
config/description="身体值班室 · Godot 迁移 POC"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=820
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.012, 0.031, 0.039, 1)
